<Window x:Class="OrionInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrionInstaller"
        Title="Orion Store Setup"
        Width="520" Height="566"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseDown"
       
        TextElement.FontWeight="Normal">

    <Window.Resources>
        <!-- Orion's dark Material 3 palette, keyed to its periwinkle brand. -->
        <SolidColorBrush x:Key="M3Surface" Color="#15151B"/>
        <SolidColorBrush x:Key="M3SurfaceContainerLow" Color="#1A1A22"/>
        <SolidColorBrush x:Key="M3SurfaceContainer" Color="#20202A"/>
        <SolidColorBrush x:Key="M3SurfaceContainerHigh" Color="#292A36"/>
        <SolidColorBrush x:Key="M3SurfaceContainerHighest" Color="#343541"/>
        <SolidColorBrush x:Key="M3Outline" Color="#484957"/>
        <SolidColorBrush x:Key="M3OutlineVariant" Color="#30313D"/>
        <SolidColorBrush x:Key="M3Primary" Color="#7478F8"/>
        <SolidColorBrush x:Key="M3OnPrimary" Color="#11122B"/>
        <SolidColorBrush x:Key="M3PrimaryContainer" Color="#343568"/>
        <SolidColorBrush x:Key="M3OnPrimaryContainer" Color="#E1E0FF"/>
        <SolidColorBrush x:Key="M3SecondaryContainer" Color="#303349"/>
        <SolidColorBrush x:Key="M3OnSecondaryContainer" Color="#DDE0FF"/>
        <SolidColorBrush x:Key="M3TextPrimary" Color="#F4F1FA"/>
        <SolidColorBrush x:Key="M3TextSecondary" Color="#B9B7C7"/>
        <SolidColorBrush x:Key="M3TextTertiary" Color="#858493"/>

        <!-- Google Sans (SIL Open Font License), embedded so the setup app never depends on it
             being installed on the machine. -->
        <FontFamily x:Key="GoogleSans">pack://application:,,,/fonts/GoogleSans-Regular.ttf#Google Sans</FontFamily>
        <FontFamily x:Key="GoogleSansBold">pack://application:,,,/fonts/GoogleSans-Bold.ttf#Google Sans</FontFamily>
        <FontFamily x:Key="GoogleSansMedium">pack://application:,,,/fonts/GoogleSans-Medium.ttf#Google Sans Medium</FontFamily>
        <FontFamily x:Key="GoogleSansSemiBold">pack://application:,,,/fonts/GoogleSans-SemiBold.ttf#Google Sans SemiBold</FontFamily>

        <!-- Type roles -->
        <Style x:Key="M3Display" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource GoogleSansBold}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource M3TextPrimary}"/>
        </Style>
        <Style x:Key="M3Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource GoogleSans}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource M3TextSecondary}"/>
        </Style>
        <Style x:Key="M3Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource GoogleSansSemiBold}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Foreground" Value="{StaticResource M3TextTertiary}"/>
        </Style>

        <Style x:Key="M3FilledButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource M3Primary}"/>
            <Setter Property="Foreground" Value="{StaticResource M3OnPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource GoogleSansBold}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#898CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#6266E7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="M3TonalButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource M3SecondaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource M3OnSecondaryContainer}"/>
            <Setter Property="FontFamily" Value="{StaticResource GoogleSansSemiBold}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TonalSurface" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TonalSurface" Property="Background" Value="{StaticResource M3SurfaceContainerHighest}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="M3WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource M3TextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource GoogleSans}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonSurface" Background="Transparent" CornerRadius="11" Width="34" Height="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WindowButtonSurface" Property="Background" Value="{StaticResource M3SurfaceContainerHighest}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="M3CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource M3TextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource GoogleSans}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckSurface" Width="19" Height="19" CornerRadius="6" Background="Transparent" BorderBrush="{StaticResource M3Outline}" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="CheckGlyph" Data="M 3,8 L 6.5,11.5 L 12,4.5" Stroke="{StaticResource M3OnPrimary}" StrokeThickness="2" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource M3Primary}"/>
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource M3Primary}"/>
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource M3TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The window itself: one rounded shell, everything else sits inside it. -->
    <Border CornerRadius="30" Background="{StaticResource M3Surface}" BorderBrush="{StaticResource M3OutlineVariant}" BorderThickness="1" Margin="12" TextElement.FontFamily="{DynamicResource GoogleSans}" TextElement.FontWeight="Normal">
        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Compact, quiet title bar. -->
            <Grid Grid.Row="0" Margin="22,0,14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="orion_icon.png" Width="20" Height="20" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="ORION STORE" Style="{StaticResource M3Label}" FontSize="10" Foreground="{StaticResource M3TextTertiary}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource M3SurfaceContainerHigh}" CornerRadius="8" Padding="7,3" Margin="9,0,0,0">
                        <TextBlock Text="SETUP" FontFamily="{StaticResource GoogleSansSemiBold}" FontWeight="SemiBold" FontSize="8" Foreground="{StaticResource M3TextSecondary}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource M3WindowButtonStyle}" Content="—" Click="MinButton_Click"/>
                    <Button Style="{StaticResource M3WindowButtonStyle}" Content="✕" Click="CloseButton_Click" Margin="3,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Orion's mark, then the name. -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,18">
                <Image Source="orion_icon.png" Width="88" Height="88" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Direction="270" Opacity="0.45" Color="#7478F8"/>
                    </Image.Effect>
                </Image>
                <TextBlock Text="Orion Store 2.0" Style="{StaticResource M3Display}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="An open-source app store, now at home on Windows." Style="{StaticResource M3Body}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="10">
                    <Run Text="Made with 💜 by " Foreground="{StaticResource M3TextTertiary}"/>
                    <Hyperlink NavigateUri="https://github.com/RookieEnough" RequestNavigate="Link_RequestNavigate">
                        <Run Text="RookieEnough" FontFamily="{StaticResource GoogleSansSemiBold}" FontWeight="SemiBold" Foreground="{StaticResource M3Primary}"/>
                    </Hyperlink>
                    <Run Text="  ·  " Foreground="{StaticResource M3TextTertiary}"/>
                    <Run Text="Windows Desktop by " Foreground="{StaticResource M3TextTertiary}"/>
                    <Run Text="Vidit" FontFamily="{StaticResource GoogleSansSemiBold}" FontWeight="SemiBold" Foreground="{StaticResource M3TextSecondary}"/>
                </TextBlock>
            </StackPanel>

            <!-- Setup options and the install-state views. -->
            <Grid Grid.Row="2" Margin="26,0,26,24">
                <Grid x:Name="ReadyView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource M3SurfaceContainer}" BorderBrush="{StaticResource M3Outline}" BorderThickness="1" CornerRadius="18" Padding="16,13" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="INSTALL LOCATION" Style="{StaticResource M3Label}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="InstallPathText" Text="C:\Users\user\AppData\Local\Programs\OrionStore" FontFamily="{StaticResource GoogleSans}" FontSize="10.5" Foreground="{StaticResource M3TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Change" Style="{StaticResource M3TonalButtonStyle}" Click="BrowseButton_Click" Padding="14,8" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource M3SurfaceContainerLow}" CornerRadius="16" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <CheckBox x:Name="DesktopShortcutCheck" IsChecked="True" Content="Desktop shortcut" Style="{StaticResource M3CheckBoxStyle}" Margin="0,0,26,0"/>
                            <CheckBox x:Name="StartMenuCheck" IsChecked="True" Content="Start menu" Style="{StaticResource M3CheckBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="2" Height="52" Style="{StaticResource M3FilledButtonStyle}" Click="InstallButton_Click" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Install Orion Store" FontFamily="{StaticResource GoogleSansBold}" FontWeight="Bold" FontSize="13" Margin="0,0,9,0"/>
                            <TextBlock Text="→" FontFamily="{StaticResource GoogleSansBold}" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid x:Name="InstallingView" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel Margin="8,0">
                        <TextBlock x:Name="ProgressStatusText" Text="Installing Orion Store 2.0..." FontFamily="{StaticResource GoogleSansSemiBold}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource M3TextPrimary}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="ProgressDetailText" Text="Unpacking bundled runtime and Compose Desktop modules..." Style="{StaticResource M3Body}" FontSize="10.5" Margin="0,0,0,20" TextTrimming="CharacterEllipsis"/>
                        <Border x:Name="ProgressTrack" Height="8" CornerRadius="4" Background="{StaticResource M3SurfaceContainerHighest}" Margin="0,0,0,12">
                            <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="{StaticResource M3Primary}"/>
                        </Border>
                        <TextBlock x:Name="ProgressPercentText" Text="0%" FontFamily="{StaticResource GoogleSansBold}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource M3OnPrimaryContainer}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="CompletedView" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="84" Height="84" CornerRadius="28" Background="{StaticResource M3PrimaryContainer}">
                            <TextBlock Text="✓" FontFamily="{StaticResource GoogleSansSemiBold}" FontWeight="SemiBold" FontSize="34" Foreground="{StaticResource M3OnPrimaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="You're all set" Style="{StaticResource M3Display}" FontSize="22" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                        <TextBlock Text="Orion Store 2.0 is installed and ready to launch." Style="{StaticResource M3Body}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <Button Width="220" Height="52" Style="{StaticResource M3FilledButtonStyle}" Click="LaunchButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Launch Orion Store" FontFamily="{StaticResource GoogleSansBold}" FontWeight="Bold" FontSize="13" Margin="0,0,9,0"/>
                                <TextBlock Text="→" FontFamily="{StaticResource GoogleSansBold}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
